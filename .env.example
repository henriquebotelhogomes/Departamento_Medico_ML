# ==========================================================================
# Example environment file. Copy to `.env` and fill in real values.
#   cp .env.example .env      (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
# Never commit the real .env file.
# ==========================================================================

# ---- App ----
APP_NAME="RadioAI"
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins (frontend dev server, prod URL...)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Security / Auth ----
# Generate a strong key, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo account seeded at startup (portfolio showcase)
DEMO_USERNAME=demo123
DEMO_PASSWORD=demo123

# ---- Database (config-driven) ----
# Local default (SQLite, async). Leave as-is to run locally with no extra setup.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Production example (Supabase Postgres, async). Use the "Connection pooling" URI:
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- Storage (config-driven) ----
STORAGE_BACKEND=local            # local | supabase
LOCAL_STORAGE_DIR=./uploads
# Supabase Storage (only used when STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=xray-uploads

# ---- ML model ----
# Path to the .keras model served for inference (see scripts/get_model.py)
MODEL_PATH=./app/ml/artifacts/model.keras
ENABLE_TTA=false

# ---- Frontend (Vite) ----
# In dev, Vite proxies /api to the backend, so this can stay empty.
VITE_API_URL=
