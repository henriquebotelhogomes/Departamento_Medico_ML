# Track large model artifacts with Git LFS
*.keras filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text

# GitHub Linguist Overrides (Exclude Jupyter Notebooks from Language Stats)
*.ipynb linguist-detectable=false linguist-documentation=true
research/*.ipynb linguist-detectable=false linguist-documentation=true

# Normalize line endings
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.dcm binary
