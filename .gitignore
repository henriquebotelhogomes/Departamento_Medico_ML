# ---- Datasets & large local data (kept out of the repo) ----
Dataset/
Dataset_mendeley/
# Anchored to the repo root: on Windows (core.ignorecase) a bare "Test/"
# would also ignore source dirs like frontend/src/test/.
/Test/
_mendeley_raw/

# ---- Large model files (use DVC or Releases for distribution) ----
*.keras
# Inference model committed via Git LFS so CI can validate the ML path.
!modelo_raiox_mendeley_ft.keras
*.h5
*.pb
*.tflite
*.onnx

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ---- uv ----
# uv.lock IS committed; only the environment is ignored.

# ---- Databases / local storage ----
*.db
*.sqlite
*.sqlite3
backend/data/
backend/uploads/
backend/app/ml/artifacts/*.keras

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---- Env & secrets ----
.env
.env.*
!.env.example

# ---- MkDocs ----
site/

