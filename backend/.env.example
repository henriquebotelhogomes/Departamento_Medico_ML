# ==============================================================================
# RadioAI — Configurações de Ambiente (Backend)
# ==============================================================================

# Segurança e Sessão
SECRET_KEY=dev-secret-key-radioai-hospital-pacs-2026-32chars
ENVIRONMENT=development
LOG_LEVEL=INFO

# Banco de Dados Local
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Armazenamento Local
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads

# Modelo Neural ResNet50
MODEL_PATH=./app/ml/artifacts/model.keras
OOD_REFERENCE_DIR=../examples

# ==============================================================================
# CHAVES DAS INTELIGÊNCIAS ARTIFICIAIS (LLMs PARA LAUDOS MÉDICOS)
# ==============================================================================

# 1. Google AI Studio (Gemini 3.8 Flash - Gratuito)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# 2. OpenCode Go (GPT 5.6 Luna, DeepSeek V4 Flash, Qwen 3.8 Flash)
# Cole a chave/token da sua assinatura do OpenCode Go
OPENCODE_API_KEY=sua_chave_do_opencode_aqui
OPENCODE_BASE_URL=https://opencode.ai/v1

# Modelo padrão inicial
DEFAULT_LLM_MODEL=gemini-3.8-flash